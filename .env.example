# Empty uses local SQLite. Docker Compose sets PostgreSQL automatically.
DATABASE_URL=
# Comma-separated browser origins. Do not use a wildcard with authenticated deployments.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Demo Mode is opt-in only. Leave disabled for normal operation.
HEATWISE_DEMO_MODE=0
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
EARTH_ENGINE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_MAPS_API_KEY=
OPENAQ_API_KEY=
REDIS_URL=
# Optional shared API access token; keep behind HTTPS. Local loopback is default.
API_TOKEN=
